; Add these entries to the PHP-FPM pool serving Tooth Lounge.
; Supply DB_PASSWORD through the service secret manager, not this file in source control.
clear_env = yes
env[APP_ENV] = production
env[APP_CANONICAL_URL] = https://clinic.example.com
env[DB_HOST] = 127.0.0.1
env[DB_NAME] = tooth-lounge
env[DB_USER] = tooth_lounge_app
env[DB_PASSWORD] = <inject-from-secret-manager>
env[AUDIT_LOG_PATH] = /var/log/tooth-lounge/security.jsonl
